rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidImageUpload() {
      return request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Bakery official portal banners: readable publicly, writable by authenticated bakery managers / admins
    match /bakeries/{bakeryId}/portal/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() &&
        isValidImageUpload() &&
        bakeryId.size() <= 128 &&
        fileName.size() <= 128;
    }

    // Tasting photo evidence attached to a verified QR vote: scoped by voter UID
    match /votes/{bakeryId}/{voterUid}/{fileName} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.auth.uid == voterUid &&
        isValidImageUpload() &&
        bakeryId.size() <= 128 &&
        fileName.size() <= 128;
      allow update, delete: if false;
    }
  }
}
